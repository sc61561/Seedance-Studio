SEEDANCE_API_KEY=

# Optional for local development. Both values are required in production;
# protected routes fail closed when either one is missing.
APP_ACCESS_PASSWORD=
SESSION_SECRET=

# Optional Vercel Blob storage for URL-first reference image uploads.
# Without it, the explicit storage-not-configured response enables the
# browser-session Data URL fallback (3 MiB total reference-image budget).
BLOB_READ_WRITE_TOKEN=
