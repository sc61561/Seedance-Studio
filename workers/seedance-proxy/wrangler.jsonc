{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "seedance-image-proxy",
  "main": "index.ts",
  "compatibility_date": "2026-09-22",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": {
    // Exact website origins, comma-separated. Never use '*'.
    "ALLOWED_ORIGINS": "https://seedance-studio-five.vercel.app"
  },
  "ratelimits": [
    {
      "name": "GENERATION_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 }
    }
  ]
}
