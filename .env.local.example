# Seedance API keys are entered by each user in the browser settings panel.
# No deployment-side Seedance key is required.

# Optional, set AFTER deploying and testing your own Cloudflare image proxy.
# An HTTPS origin only (no path/query). Rebuild/redeploy Next.js after changing.
# NEXT_PUBLIC_SEEDANCE_WORKER_ORIGIN=https://seedance-image-proxy.YOUR-SUBDOMAIN.workers.dev
